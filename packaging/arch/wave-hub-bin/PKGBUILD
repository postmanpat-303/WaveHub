# Maintainer: Del (postmanpat) <https://github.com/postmanpat-303>
# Prebuilt Wave Hub from the GitHub release tarball (built for glibc 2.31 and newer).
# Build:  makepkg -si      (Arch / CachyOS / Manjaro / EndeavourOS)
pkgname=wave-hub-bin
pkgver=0.2.5
pkgrel=1
pkgdesc="Free launcher that installs, updates and opens the Wave apps (BigWave Radio, ChipWave Tracker, StreamWave)"
arch=('x86_64' 'aarch64')
url="https://github.com/postmanpat-303/WaveHub"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'libxkbcommon-x11' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'wayland' 'libglvnd' 'hicolor-icon-theme' 'xdg-utils')
provides=('wave-hub')
conflicts=('wave-hub')
options=('!strip' '!debug')
source_x86_64=("WaveHub-$pkgver-linux-x86_64.tar.gz::$url/releases/download/v$pkgver/WaveHub-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("WaveHub-$pkgver-linux-aarch64.tar.gz::$url/releases/download/v$pkgver/WaveHub-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "WaveHub-$pkgver-linux-$CARCH"
  install -Dm755 wave-hub "$pkgdir/usr/bin/wave-hub"
  install -Dm644 share/applications/wave-hub.desktop "$pkgdir/usr/share/applications/wave-hub.desktop"
  install -Dm644 share/metainfo/wave-hub.metainfo.xml "$pkgdir/usr/share/metainfo/wave-hub.metainfo.xml"
  for s in 16 32 48 64 128 256 512; do
    install -Dm644 "share/icons/hicolor/${s}x${s}/apps/wave-hub.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/wave-hub.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

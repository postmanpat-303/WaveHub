{
  "launcher_repo": "postmanpat-303/WaveHub",
  "community_url": "https://buymeacoffee.com/postmanpat",
  "apps": [
    {
      "id": "bigwave-radio",
      "name": "BigWave Radio",
      "description": "Free internet radio with mood chips, plugins and a visualiser.",
      "repo": "postmanpat-303/BigWaveRadio",
      "icon": "bigwave_radio",
      "accent": [
        62,
        224,
        26
      ],
      "sums": "SHA256SUMS.txt",
      "windows": {
        "portable": "BigWaveRadio-{version}-windows-x64.zip",
        "exe": "BigWaveRadio.exe",
        "installer": "BigWaveRadio-{version}-setup-x64.exe",
        "installed_exe": [
          "{programfiles}\\BigWave Radio\\BigWaveRadio.exe"
        ],
        "silent_args": [
          "/S"
        ],
        "uninstall_key": "BigWaveRadio"
      },
      "linux": {
        "appimage": "BigWaveRadio-{version}-linux-{arch}.AppImage",
        "arches": [
          "x86_64",
          "aarch64"
        ]
      },
      "macos": {
        "zip": "BigWaveRadio-{version}-macos-universal.zip",
        "exe": "BigWave Radio.app/Contents/MacOS/BigWaveRadio"
      }
    },
    {
      "id": "chipwave-tracker",
      "name": "ChipWave Tracker",
      "description": "A modern OctaMED-inspired music tracker.",
      "repo": "postmanpat-303/ChipWaveTracker",
      "icon": "chipwave_tracker",
      "accent": [
        20,
        92,
        255
      ],
      "windows": {
        "portable": "ChipWave-{version}-windows-x64.zip",
        "exe": "ChipWave.exe",
        "installer": "ChipWave-{version}-setup-x64.exe",
        "installed_exe": [
          "{programfiles}\\ChipWave Tracker\\ChipWave.exe"
        ],
        "silent_args": [
          "/S"
        ],
        "uninstall_key": "ChipWaveTracker"
      },
      "linux": {
        "unavailable": "Windows only for now. On Linux, build it from source."
      },
      "macos": {
        "unavailable": "Not available on Mac yet."
      }
    },
    {
      "id": "streamwave",
      "name": "StreamWave",
      "description": "Record and edit audio for streams and podcasts, with OBS sync.",
      "repo": "postmanpat-303/StreamWave",
      "icon": "streamwave",
      "accent": [
        255,
        112,
        10
      ],
      "sums": "SHA256SUMS.txt",
      "windows": {
        "installer": "StreamWave_{version}_x64-setup.exe",
        "installed_exe": [
          "{localappdata}\\StreamWave\\StreamWave.exe",
          "{programfiles}\\StreamWave\\StreamWave.exe"
        ],
        "silent_args": [
          "/S"
        ],
        "uninstall_key": "StreamWave"
      },
      "linux": {
        "appimage": "StreamWave_{version}_amd64.AppImage"
      },
      "macos": {
        "unavailable": "Not available on Mac yet."
      }
    }
  ]
}
